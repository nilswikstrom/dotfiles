#!/usr/bin/env bash
set -euo pipefail

# Live brightness slider for Wayland/Hyprland using yad + brightnessctl.
# Updates brightness as you drag (no need to press OK to preview).

# Current brightness in %
current="$(brightnessctl -m | awk -F, '{print $4}' | tr -d '%')"
current="${current:-50}"

# Stream slider values while dragging and apply them live
yad --scale \
  --title="Brightness Slider" \
  --text="Drag to set brightness" \
  --min-value=1 --max-value=100 \
  --value="$current" \
  --step=2 \
  --print-partial \
  --undecorated \
  --skip-taskbar \
  --on-top \
  --button="Close:0" \
| while IFS= read -r v; do
    # yad can output empty lines sometimes; ignore those
    [[ -n "${v:-}" ]] || continue
    brightnessctl set "${v}%"
  done

exit 0
